# Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# PitchStudy v1 is a static content site — no database or accounts required.
# Most vars below are commented out until Phase 3 (accounts/progress tracking)
# or a headless CMS is adopted.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
PORT=3000
LOG_LEVEL=info               # debug | info | warn | error

# ── Content (if a headless CMS replaces local MDX) ───────────────────────────
# SANITY_PROJECT_ID=...
# SANITY_DATASET=production
# SANITY_API_TOKEN=...
# CONTENTFUL_SPACE_ID=...
# CONTENTFUL_ACCESS_TOKEN=...

# ── Analytics ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=...

# ── Tactics Lab coach verdict (Phase 3 of that feature) ──────────────────────
# Server-side only — never exposed to the client. Without it, the Lab's
# "Send to the coaching staff" button stays disabled and the deterministic
# analysis engine runs on its own, which is the intended fallback, not an
# error state.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Accounts (optional — "Join the Club") ────────────────────────────────────
# Supabase project URL + anon/public key (Project Settings -> API). Both are
# safe to expose client-side — they're not secrets, access is enforced by the
# profiles table's row-level security policies (see supabase/schema.sql).
# Without these, every auth entry point (header JOIN link, /join, /login)
# quietly falls back to "not configured yet" instead of erroring, and the
# whole guest experience (Trial Day, Training Ground, XP, Academy, Tactics
# Lab) is completely unaffected — accounts are sync only, never a gate.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
#
# To enable Google sign-in: Supabase dashboard -> Authentication -> Providers
# -> Google, using a Google Cloud OAuth client (no extra env var here — that
# secret lives in Supabase's own provider config, not this app).
