# Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# PitchStudy v1 is a static content site — no database or accounts required.
# Most vars below are commented out until Phase 3 (accounts/progress tracking)
# or a headless CMS is adopted.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
PORT=3000
LOG_LEVEL=info               # debug | info | warn | error

# ── Content (if a headless CMS replaces local MDX) ───────────────────────────
# SANITY_PROJECT_ID=...
# SANITY_DATASET=production
# SANITY_API_TOKEN=...
# CONTENTFUL_SPACE_ID=...
# CONTENTFUL_ACCESS_TOKEN=...

# ── Analytics ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ID=...

# ── Tactics Lab coach verdict (Phase 3 of that feature) ──────────────────────
# Server-side only — never exposed to the client. Without it, the Lab's
# "Send to the coaching staff" button stays disabled and the deterministic
# analysis engine runs on its own, which is the intended fallback, not an
# error state.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Phase 3 — Accounts & Database (not needed for v1) ────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/pitchstudy
# JWT_SECRET=replace_with_a_long_random_string_min_32_chars
# SESSION_SECRET=replace_with_another_long_random_string
